{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "translate",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-19",
  /**
   * Our own account, not the upstream author's. A `git pull` that reintroduces
   * their account_id is why this file is worth reading after every merge.
   */
  "account_id": "cd1e88db5a44de0f45317275cbcef879",
  "observability": {
    "enabled": true
  },
  /**
   * A custom domain rather than workers.dev: the whole point of this instance is
   * a translation endpoint we control and can hand a key to.
   */
  "routes": [
    {
      "pattern": "translate.jonas-strassel.de",
      "custom_domain": true
    }
  ],
  /**
   * Not reachable without a key. Upstream ships no auth at all — it advertises
   * that as a feature — which is wrong for a host we own: an open proxy here is
   * someone else's free API, and their volume is what gets our IP blocked
   * upstream. That block is the reason this instance exists.
   *
   *   npx wrangler secret put API_KEYS
   *
   * Comma-separated, so a single client can be revoked without rotating the
   * rest. Unset means the worker refuses everything; see src/lib/apiKey.ts.
   */
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "ba491fed823141778ecd60b55861e0e8"
    },
    {
      "binding": "RATE_LIMIT_KV",
      "id": "2505ece6a81841acb61acb9c2c19223e"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS"
    }
  ],
  "placement": {
    "mode": "smart"
  },
  /** Upstream's five-minute cron only clears the in-memory cache. */
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "DEBUG_MODE": "false"
  },
  "workers_dev": false
}
